# --- AI assessment (server-side only; never exposed to the browser) ---
# Leave blank to run in clearly-labelled DEMO mode (deterministic simulated assessor).
ANTHROPIC_API_KEY=your_api_key_here
# demo | live   (live requires ANTHROPIC_API_KEY)
CDP_AI_MODE=demo
CDP_MODEL=claude-sonnet-5-5

# --- Email (leave SMTP_HOST blank for DEMO outbox mode: emails are logged, not sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cdp-champions@example.gov
SMTP_STARTTLS=true

# --- Application ---
CDP_BASE_URL=http://localhost:8000
CDP_SECRET_KEY=change-me-to-a-long-random-string
CDP_LEAD_EMAIL=change.lead@example.gov
CDP_DB=data/cdp.sqlite3
CDP_UPLOAD_DIR=data/uploads
