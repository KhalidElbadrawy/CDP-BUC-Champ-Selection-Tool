# --- AI (server-side only) ---
# Leave blank to run in clearly-labelled DEMO mode (simulated AI results).
ANTHROPIC_API_KEY=your_api_key_here
# demo | live   (live requires ANTHROPIC_API_KEY)
CDP_AI_MODE=demo
CDP_MODEL=claude-sonnet-5-5

# --- Change Lead sign-in ---
# Leave blank locally to use the demo password "demo". Required (10+ characters) in production.
CDP_LEAD_PASSWORD=

# --- Application ---
CDP_BASE_URL=http://localhost:8000
CDP_SECRET_KEY=change-me-to-a-long-random-string
CDP_DB=data/cdp.sqlite3
CDP_UPLOAD_DIR=data/uploads
